#!/bin/bash
# Builds the cloud-init seed drive that provisions a bare-metal node.
#
# ## How this works, because it is not obvious
#
# A node is provisioned by writing Ubuntu's *cloud image* directly to its disk
# from another machine, rather than by booting an installer on it. An installer
# needs the box to boot removable media, which on a second-hand business machine
# means betting on the boot order and on there being no BIOS admin password left
# by the previous owner. Writing the disk sidesteps all of it: the machine boots
# the internal disk it is already configured to boot.
#
# The cloud image is generic, so configuration arrives separately. cloud-init's
# NoCloud datasource looks, among other places, for a filesystem *labelled*
# `CIDATA` holding two files at its root: `user-data` (the #cloud-config) and
# `meta-data`. That label is the entire mechanism — nothing else identifies the
# volume, which is why this script formats rather than assumes.
#
# A separate volume rather than editing the image, because macOS cannot write
# ext4 and the FUSE options for it are a kernel extension away (or corrupt the
# filesystem). Both halves of this approach are then things macOS does natively:
# raw blocks to the disk, files to FAT32.
#
# `meta-data`'s `instance-id` is what makes this first-boot-only; cloud-init
# records it and skips everything if it has seen that id before. The stick can
# be pulled once the node is up.
#
# Two behaviours come free from the cloud image and are relied on here: growpart
# expands the root partition to fill the disk on first boot, and with no network
# config in the seed cloud-init falls back to DHCP.
#
# ## Secrets
#
# Nothing secret is stored in this repo. The SSH key comes from the running
# agent, and the k3s join token is read from the cluster at build time.
#
# Usage: scripts/make-seed-drive <device> <hostname> [--no-join]
#   scripts/make-seed-drive /dev/disk4 lady
set -euo pipefail

DEVICE="${1:?usage: make-seed-drive <device> <hostname> [--no-join]}"
HOSTNAME="${2:?usage: make-seed-drive <device> <hostname> [--no-join]}"
JOIN=true
[[ "${3:-}" == "--no-join" ]] && JOIN=false

USER_NAME="${SEED_USER:-jc}"
CONTEXT="${KUBE_CONTEXT:-jaritanet}"

# Non-ephemeral (an ephemeral node is dropped from the tailnet when it goes
# offline, taking the address kubelet advertises with it) and tagged, since
# tagged nodes have no key expiry — otherwise the node silently leaves the
# tailnet months later and the control plane loses its route to the kubelet.
$JOIN && : "${TS_AUTHKEY:?set TS_AUTHKEY to a non-ephemeral, tagged tailscale auth key}"

# Refuse anything that is not an external disk. The failure mode this guards
# against is unrecoverable, and `diskutil list` numbering shifts between boots.
if ! diskutil info "$DEVICE" | grep -q "Device Location:.*External"; then
  echo "$DEVICE is not an external disk — refusing" >&2
  exit 1
fi

PUBKEY="$(ssh-add -L | grep -m1 '^ssh-' || true)"
[[ -n "$PUBKEY" ]] || { echo "no key in the ssh agent — unlock it first" >&2; exit 1; }

diskutil info "$DEVICE" | grep -E "Device / Media Name|Disk Size"
read -rp "Erase $DEVICE and write a seed for '$HOSTNAME'? [y/N] " ok
[[ "$ok" == "y" ]] || exit 1

# eraseDisk on the whole device, not eraseVolume on a partition: a disk holding
# a dd'd installer ISO has a hybrid partition map that Disk Utility cannot
# modify in place, which is the "Couldn't modify partition map (-69874)" dead
# end. Rewriting the map wholesale is what works.
diskutil unmountDisk force "$DEVICE"
diskutil eraseDisk FAT32 CIDATA MBRFormat "$DEVICE"

VOL=/Volumes/CIDATA
printf 'instance-id: %s-%s\nlocal-hostname: %s\n' \
  "$HOSTNAME" "$(date +%Y%m%d%H%M%S)" "$HOSTNAME" > "$VOL/meta-data"

{
  cat <<YAML
#cloud-config
# Generated by scripts/make-seed-drive. Consumed once, on first boot.

hostname: $HOSTNAME
manage_etc_hosts: true

# No \`default\` entry, so the image's stock \`ubuntu\` user is never created.
users:
  - name: $USER_NAME
    groups: [sudo, adm]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - $PUBKEY

ssh_pwauth: false
disable_root: true

package_update: true
packages:
  - curl
  - ca-certificates
YAML

  if $JOIN; then
    SERVER="$(kubectl --context "$CONTEXT" config view --minify \
      -o jsonpath='{.clusters[0].cluster.server}')"
    VERSION="$(kubectl --context "$CONTEXT" get nodes \
      -l node-role.kubernetes.io/control-plane \
      -o jsonpath='{.items[0].status.nodeInfo.kubeletVersion}')"
    TOKEN="$(scripts/k3s-node-token "$CONTEXT")"
    cat <<YAML

# One ordered script rather than separate entries, because the steps depend on
# each other and \`set -e\` then stops the whole thing at the first failure. That
# matters more than usual here: runcmd is gated by instance-id and never runs
# again, so a node that joins with the wrong address stays wrong. Better to
# arrive with no k3s at all, which is obvious and fixable at the console.
#
# Tailscale first, because \`--node-ip\` needs the address it hands out. The node
# is behind NAT: it dials the API server outbound fine, but kubelet is reached
# the other way, control plane to node on :10250, and an address only routable
# on the home LAN makes \`kubectl logs\` and \`exec\` hang rather than fail.
#
# The k3s version is pinned to the server's rather than left to \`latest\`, so a
# release landing between now and first boot cannot put the agent ahead of the
# control plane. No VPN entry label and no taint: which machine serves a VPN
# entry is a property of that machine, and this one is a workload node.
runcmd:
  - - sh
    - -c
    - |
      set -eu
      curl -fsSL "https://pkgs.tailscale.com/stable/ubuntu/\$(lsb_release -cs).noarmor.gpg" \\
        > /usr/share/keyrings/tailscale-archive-keyring.gpg
      curl -fsSL "https://pkgs.tailscale.com/stable/ubuntu/\$(lsb_release -cs).tailscale-keyring.list" \\
        > /etc/apt/sources.list.d/tailscale.list
      apt-get update -qq
      DEBIAN_FRONTEND=noninteractive apt-get install -y -qq tailscale
      tailscale up --auth-key='$TS_AUTHKEY' --hostname='$HOSTNAME' --accept-dns=false
      NODE_IP="\$(tailscale ip -4)"
      curl -sfL https://get.k3s.io | \\
        INSTALL_K3S_VERSION='$VERSION' \\
        K3S_URL='$SERVER' \\
        K3S_TOKEN='$TOKEN' \\
        INSTALL_K3S_EXEC="agent --node-ip=\$NODE_IP" \\
        sh -
YAML
  fi

  printf '\nfinal_message: "%s up after $UPTIME seconds"\n' "$HOSTNAME"
} > "$VOL/user-data"

chmod 600 "$VOL/user-data"
python3 -c "import yaml,sys; yaml.safe_load(open('$VOL/user-data'))" \
  && echo "user-data parses as YAML"

# Left mounted so the result can be read back — a seed is worth looking at
# before it is the only thing standing between a box and a working node. Flushed
# rather than ejected, so what is on the volume is what is on the flash.
sync
echo "seed for '$HOSTNAME' written to $VOL — inspect it, then eject before pulling"
