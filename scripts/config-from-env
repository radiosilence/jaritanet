#!/bin/bash
# Moves the values a deploy needs out of the environment and into the stack.
#
# Config first, environment second (see env.ts): once a value is in the stack a
# deploy needs nothing but a Pulumi login, rather than twenty variables
# assembled by hand — where an omission is not an error but an empty string, and
# an empty hostname silently removes a service.
#
# Deliberately dull. Everything here reads values through printenv and never
# interpolates one anywhere it could be echoed: indirect expansion and
# associative-array subscripts both evaluate their argument, and under `set -u`
# that puts a secret into an error message.
#
# Usage: scripts/config-from-env [--dry-run]
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DRY=false
[[ "${1:-}" == "--dry-run" ]] && DRY=true

# ACME_EMAIL in the environment is acmeEmail in the stack — the same transform
# env.ts applies, so the two cannot disagree about where a value lives.
camel() {
  # awk rather than sed: \u is a GNU extension and this runs on BSD sed too.
  printf '%s' "$1" | awk 'BEGIN{FS="_";OFS=""}{
    for(i=1;i<=NF;i++){
      w=tolower($i)
      printf "%s", (i==1 ? w : toupper(substr(w,1,1)) substr(w,2))
    }
  }'
}

# $1 environment variable to read, $2 stack config key to write.
migrate() {
  local from="$1" to="$2" value
  value="$(printenv "$from" 2>/dev/null || true)"
  if [[ -z "$value" ]]; then
    printf '  skip %-26s (not set)\n' "$to"
    return
  fi
  if $DRY; then
    printf '  would set %-21s (%s chars)\n' "$to" "${#value}"
    return
  fi
  printf '%s' "$value" | pulumi -C "$ROOT/packages/infra" config set --secret "$to" >/dev/null
  printf '  set %-27s (%s chars)\n' "$to" "${#value}"
}

# Everything env.schema.ts reads, plus the values referenced as ${VAR} in
# Pulumi.main.yaml. PULUMI_ACCESS_TOKEN is absent deliberately: it is how CI
# reaches Pulumi, so it cannot live inside Pulumi.
for key in \
  ACME_EMAIL BLIT_HOSTNAME CLOUDFLARE_ACCOUNT_ID DEPLOY_TOKEN FILES_HOSTNAME \
  GH_ALLOWED GH_CLIENT_ID GH_CLIENT_SECRET MCP_AUTH_HOSTNAME MCP_HOSTNAME \
  NAVIDROME_HOSTNAME SSH_PUBLIC_KEY TAILNET_MAGICDNS_SUFFIX TELEGRAM_BOT_TOKEN \
  TELEGRAM_CHAT_ID TS_AUTHKEY TS_OAUTH_CLIENT_ID TS_OAUTH_CLIENT_SECRET \
  TS_TAILNET UBUNTU_PRO_TOKEN VPN_ENTRY_LABEL VPN_USERS \
  CLOUDFLARE_API_TOKEN HCLOUD_TOKEN
do
  migrate "$key" "$(camel "$key")"
done

# The same two again, under the keys Pulumi's own providers read. They are
# needed twice: the providers authenticate with them, and the program passes the
# Cloudflare one to Traefik for DNS-01 while the Hetzner one decides whether
# there is a gateway at all.
migrate CLOUDFLARE_API_TOKEN cloudflare:apiToken
migrate HCLOUD_TOKEN hcloud:token
