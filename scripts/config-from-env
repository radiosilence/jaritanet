#!/bin/bash
# Moves the values a deploy needs out of the environment and into the stack.
#
# Config first, environment second (see env.ts): once a value is in the stack a
# deploy needs nothing but a Pulumi login, rather than twenty variables
# assembled by hand — where an omission is not an error but an empty string, and
# an empty hostname silently removes a service.
#
# Set as secrets uniformly, including the hostnames. They are not secret in the
# cryptographic sense, but this repo is public and they are the reason the
# `${VAR}` indirection exists at all.
#
# Usage: scripts/config-from-env [--dry-run]
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DRY=false
[[ "${1:-}" == "--dry-run" ]] && DRY=true

# Everything env.schema.ts reads, plus the values referenced as ${VAR} in
# Pulumi.main.yaml. PULUMI_ACCESS_TOKEN is deliberately absent: it is how CI
# reaches Pulumi in the first place, so it cannot live inside Pulumi.
KEYS=(
  ACME_EMAIL BLIT_HOSTNAME CLOUDFLARE_ACCOUNT_ID DEPLOY_TOKEN FILES_HOSTNAME
  GH_ALLOWED GH_CLIENT_ID GH_CLIENT_SECRET MCP_AUTH_HOSTNAME MCP_HOSTNAME
  NAVIDROME_HOSTNAME SINGBOX_SLUG SSH_PUBLIC_KEY TAILNET_MAGICDNS_SUFFIX
  TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID TS_AUTHKEY TS_OAUTH_CLIENT_ID
  TS_OAUTH_CLIENT_SECRET UBUNTU_PRO_TOKEN VPN_ENTRY_LABEL VPN_USERS
)

# The provider credentials Pulumi reads under its own keys rather than ours.
declare -A PROVIDER=( [CLOUDFLARE_API_TOKEN]=cloudflare:apiToken [HCLOUD_TOKEN]=hcloud:token )

set_one() {
  local key="$1" value="$2"
  if $DRY; then printf '  would set %-28s (%s chars)\n' "$key" "${#value}"; return; fi
  pulumi -C "$ROOT/packages/infra" config set --secret "$key" "$value" >/dev/null
  printf '  set %-28s (%s chars)\n' "$key" "${#value}"
}

# printenv rather than ${!key}: indirect expansion under `set -u` can end up
# treating the *value* as a variable name, which puts a secret in an error
# message. Nothing here should be able to print a value.
for key in "${KEYS[@]}"; do
  value="$(printenv "$key" 2>/dev/null || true)"
  [[ -z "$value" ]] && { printf '  skip %-27s (not in environment)\n' "$key"; continue; }
  set_one "$key" "$value"
done

for key in "${!PROVIDER[@]}"; do
  value="$(printenv "$key" 2>/dev/null || true)"
  [[ -z "$value" ]] && { printf '  skip %-27s (not in environment)\n' "${PROVIDER[$key]}"; continue; }
  set_one "${PROVIDER[$key]}" "$value"
done
