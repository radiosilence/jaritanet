{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "./schemas",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "apps/*/assets/*.css",
    "apps/*/assets/*.js",
    "apps/*/target",
    "apps/*/templates"
  ]
}
