{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "config": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": ["config"],
  "description": "Schema for infrastructure configuration",
  "title": "Infrastructure Configuration Schema",
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "jaritanet:cloudflare": {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            }
          },
          "required": ["accountId"]
        },
        "jaritanet:edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hysteria": {
                "default": {
                  "altPorts": [3478, 4500],
                  "port": 443,
                  "sni": "www.bing.com"
                },
                "$ref": "#/$defs/__schema1"
              },
              "image": {
                "default": "ubuntu-24.04",
                "type": "string"
              },
              "location": {
                "default": "hel1",
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "reality": {
                "default": {
                  "dest": "www.microsoft.com:443",
                  "serverName": "www.microsoft.com"
                },
                "type": "object",
                "properties": {
                  "dest": {
                    "default": "www.microsoft.com:443",
                    "type": "string"
                  },
                  "serverName": {
                    "default": "www.microsoft.com",
                    "type": "string"
                  }
                }
              },
              "serverType": {
                "default": "cx23",
                "type": "string"
              },
              "zone": {
                "default": "radiosilence.dev",
                "type": "string"
              }
            },
            "required": ["name"]
          }
        },
        "jaritanet:exits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "image": {
                "default": "ghcr.io/shadowsocks/ssserver-rust:v1.24.0",
                "type": "string"
              },
              "method": {
                "default": "aes-256-gcm",
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "port": {
                "type": "number"
              },
              "substrate": {
                "default": "k8s",
                "type": "string",
                "enum": ["k8s"]
              }
            },
            "required": ["name"]
          }
        },
        "jaritanet:gateway": {
          "type": "object",
          "properties": {
            "hysteria": {
              "$ref": "#/$defs/__schema1"
            },
            "name": {
              "default": "sympathy",
              "type": "string"
            },
            "image": {
              "default": "ubuntu-24.04",
              "type": "string"
            },
            "k3s": {
              "type": "object",
              "properties": {
                "ciliumVersion": {
                  "default": "1.19.6",
                  "type": "string"
                },
                "version": {
                  "default": "v1.36.2+k3s1",
                  "type": "string"
                }
              }
            },
            "location": {
              "default": "nbg1",
              "type": "string"
            },
            "ratholeVersion": {
              "default": "v0.5.0",
              "type": "string"
            },
            "serverType": {
              "default": "cx23",
              "type": "string"
            },
            "tailnet": {
              "type": "object",
              "properties": {
                "hostname": {
                  "default": "jaritanet-gw",
                  "type": "string"
                },
                "tag": {
                  "default": "tag:server",
                  "type": "string"
                }
              }
            },
            "xray": {
              "type": "object",
              "properties": {
                "dest": {
                  "default": "127.0.0.1:8443",
                  "type": "string"
                },
                "serverNames": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema2"
                  }
                },
                "version": {
                  "default": "v26.3.27",
                  "type": "string"
                }
              },
              "required": ["serverNames"]
            }
          }
        },
        "jaritanet:mcpGateway": {
          "type": "object",
          "properties": {
            "hostname": {
              "default": "",
              "type": "string"
            },
            "authHostname": {
              "default": "",
              "type": "string"
            },
            "image": {
              "$ref": "#/$defs/__schema3"
            },
            "hydraTag": {
              "default": "v2.2.0",
              "type": "string"
            },
            "replicas": {
              "default": 2,
              "type": "number"
            },
            "limits": {
              "default": {
                "cpu": "500m",
                "memory": "256Mi"
              },
              "$ref": "#/$defs/__schema4"
            },
            "postgresStorageClass": {
              "type": "string"
            },
            "mcps": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/$defs/__schema5"
                  },
                  "name": {
                    "$ref": "#/$defs/__schema6"
                  },
                  "image": {
                    "$ref": "#/$defs/__schema7"
                  },
                  "args": {
                    "$ref": "#/$defs/__schema8"
                  },
                  "port": {
                    "$ref": "#/$defs/__schema9"
                  },
                  "path": {
                    "$ref": "#/$defs/__schema10"
                  },
                  "credentialHeader": {
                    "$ref": "#/$defs/__schema11"
                  },
                  "fields": {
                    "$ref": "#/$defs/__schema12"
                  },
                  "public": {
                    "$ref": "#/$defs/__schema13"
                  },
                  "graphqlPath": {
                    "$ref": "#/$defs/__schema14"
                  },
                  "keyHelpUrl": {
                    "$ref": "#/$defs/__schema15"
                  },
                  "keyHint": {
                    "$ref": "#/$defs/__schema16"
                  },
                  "verify": {
                    "$ref": "#/$defs/__schema17"
                  }
                },
                "required": ["id", "name", "image"]
              }
            }
          },
          "required": ["image"]
        },
        "jaritanet:traefik": {
          "type": "object",
          "properties": {
            "acmeEmail": {
              "type": "string"
            },
            "chartVersion": {
              "default": "41.0.2",
              "type": "string"
            }
          },
          "required": ["acmeEmail"]
        },
        "jaritanet:services": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "args": {
                "type": "object",
                "properties": {
                  "dropCapabilities": {
                    "default": false,
                    "type": "boolean"
                  },
                  "env": {
                    "default": {},
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "healthCheck": {
                    "type": "object",
                    "properties": {
                      "enableLiveness": {
                        "default": true,
                        "type": "boolean"
                      },
                      "enableReadiness": {
                        "default": true,
                        "type": "boolean"
                      },
                      "enableStartup": {
                        "default": false,
                        "type": "boolean"
                      },
                      "failureThreshold": {
                        "default": 3,
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "httpHeaders": {
                        "default": [
                          {
                            "name": "X-Health-Check",
                            "value": "k8s"
                          }
                        ],
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "value": {
                              "type": "string"
                            }
                          },
                          "required": ["name", "value"]
                        }
                      },
                      "initialDelaySeconds": {
                        "default": 30,
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "path": {
                        "default": "/_health",
                        "type": "string"
                      },
                      "periodSeconds": {
                        "default": 10,
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "port": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "successThreshold": {
                        "default": 1,
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "timeoutSeconds": {
                        "default": 5,
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      }
                    }
                  },
                  "hostVolumes": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "hostPath": {
                          "type": "string"
                        },
                        "hostPathType": {
                          "default": "Directory",
                          "type": "string",
                          "enum": [
                            "DirectoryOrCreate",
                            "Directory",
                            "FileOrCreate",
                            "File",
                            "Socket",
                            "CharDevice",
                            "BlockDevice"
                          ]
                        },
                        "mountPath": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "readOnly": {
                          "default": true,
                          "type": "boolean"
                        }
                      },
                      "required": ["hostPath", "mountPath", "name"]
                    }
                  },
                  "httpPort": {
                    "default": 80,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "networkPolicy": {
                    "default": false,
                    "type": "boolean"
                  },
                  "restrictIngress": {
                    "default": false,
                    "type": "boolean"
                  },
                  "image": {
                    "$ref": "#/$defs/__schema3"
                  },
                  "limits": {
                    "$ref": "#/$defs/__schema4"
                  },
                  "persistence": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "hostPath": {
                          "type": "string"
                        },
                        "mountPath": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "nodeAffinityHostname": {
                          "type": "string"
                        },
                        "readOnly": {
                          "default": true,
                          "type": "boolean"
                        },
                        "storage": {
                          "type": "string"
                        },
                        "storageClassName": {
                          "default": "local-storage",
                          "type": "string"
                        }
                      },
                      "required": [
                        "hostPath",
                        "mountPath",
                        "name",
                        "nodeAffinityHostname",
                        "storage"
                      ]
                    }
                  },
                  "ports": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ]
                    }
                  },
                  "replicas": {
                    "default": 1,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "securityContext": {
                    "type": "object",
                    "properties": {
                      "fsGroup": {
                        "type": "number"
                      },
                      "runAsGroup": {
                        "type": "number"
                      },
                      "runAsUser": {
                        "type": "number"
                      }
                    }
                  },
                  "strategy": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "default": "RollingUpdate",
                        "type": "string",
                        "enum": ["Recreate", "RollingUpdate"]
                      }
                    }
                  }
                },
                "required": ["image"]
              },
              "hostname": {
                "type": "string"
              }
            },
            "required": ["args"]
          }
        },
        "jaritanet:zones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "modules": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["bluesky", "fastmail"]
                }
              },
              "name": {
                "type": "string"
              },
              "zoneId": {
                "type": "string"
              }
            },
            "required": ["modules", "name", "zoneId"]
          }
        },
        "jaritanet:fastmail": {
          "type": "object",
          "properties": {
            "dkimDomain": {
              "type": "string"
            },
            "dkimSubdomain": {
              "type": "string"
            },
            "dmarcAggEmail": {
              "type": "string"
            },
            "dmarcPolicy": {
              "type": "string"
            },
            "dmarcSubdomain": {
              "type": "string"
            },
            "mxDomain": {
              "type": "string"
            },
            "spfDomain": {
              "type": "string"
            }
          },
          "required": [
            "dkimDomain",
            "dkimSubdomain",
            "dmarcAggEmail",
            "dmarcPolicy",
            "dmarcSubdomain",
            "mxDomain",
            "spfDomain"
          ]
        },
        "jaritanet:bluesky": {
          "type": "object",
          "properties": {
            "did": {
              "type": "string"
            }
          },
          "required": ["did"]
        },
        "cloudflare:apiToken": {
          "type": "object",
          "properties": {
            "secure": {
              "type": "string"
            }
          },
          "required": ["secure"]
        },
        "hcloud:token": {
          "type": "object",
          "properties": {
            "secure": {
              "type": "string"
            }
          },
          "required": ["secure"]
        }
      },
      "required": [
        "jaritanet:cloudflare",
        "jaritanet:gateway",
        "jaritanet:traefik",
        "jaritanet:services",
        "jaritanet:zones",
        "jaritanet:fastmail",
        "jaritanet:bluesky",
        "cloudflare:apiToken",
        "hcloud:token"
      ]
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "altPorts": {
          "default": [3478, 4500],
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "port": {
          "default": 443,
          "type": "number"
        },
        "sni": {
          "default": "www.bing.com",
          "type": "string"
        }
      }
    },
    "__schema2": {
      "type": "string"
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "pullPolicy": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      },
      "required": ["repository", "tag"]
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "cpu": {
          "default": "50m",
          "type": "string"
        },
        "memory": {
          "default": "64Mi",
          "type": "string"
        }
      }
    },
    "__schema5": {
      "type": "string"
    },
    "__schema6": {
      "type": "string"
    },
    "__schema7": {
      "type": "string"
    },
    "__schema8": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "__schema9": {
      "default": 8080,
      "type": "number"
    },
    "__schema10": {
      "default": "/mcp",
      "type": "string"
    },
    "__schema11": {
      "type": "string"
    },
    "__schema12": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "header": {
            "type": "string"
          },
          "secret": {
            "type": "boolean"
          },
          "default": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "optionsQuery": {
            "type": "string"
          },
          "syncMutation": {
            "type": "string"
          }
        },
        "required": ["id", "label", "header"]
      }
    },
    "__schema13": {
      "type": "boolean"
    },
    "__schema14": {
      "type": "string"
    },
    "__schema15": {
      "type": "string"
    },
    "__schema16": {
      "type": "string"
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "ok": {
          "type": "string"
        },
        "rejected": {
          "type": "string"
        }
      },
      "required": ["query"]
    }
  }
}
