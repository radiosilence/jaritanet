# The mcp-gateway Pulumi component is published from its own repository to
# GitHub Packages, which wants a token even for a public package.
@radiosilence:registry=https://npm.pkg.github.com

# The token itself lives in a file this one points at, not in an ${ENV} here:
# aube refuses to expand environment variables in auth settings that a project
# controls, since a checked-in .npmrc could otherwise exfiltrate whatever is in
# the environment of anyone who installs. `mise run auth` writes it from the gh
# login you already have; CI writes it from GITHUB_TOKEN.
npmrc-auth-file=.npmrc.auth

# Every @jaritanet package is a workspace member, but the scope on the public
# registry belongs to someone else. Routing it to a reserved TLD (RFC 2606)
# makes any registry lookup for it fail instead of fetching their package.
@jaritanet:registry=https://registry.invalid/
